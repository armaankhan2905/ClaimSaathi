# Settings for a hosted ClaimSaathi. Copy to .env.production (git and Docker ignore it), fill in,
# and give it to the server, e.g.  docker run --env-file backend/.env.production ...
# Most hosts also let you paste these into their "Environment variables" page instead.

APP_ENV=production

# Required. The server refuses to start in production without these two.
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# Back this key up: without it the stored documents can't be read.
FILE_ENCRYPTION_KEY=

# AI (optional; without a key the app runs in basic mode)
GROQ_API_KEY=
# ANTHROPIC_API_KEY=

# Only needed if the website is served from a different address than the API.
# CORS_ORIGINS=https://claimsaathi.example.com

# Create the fictional demo account on start-up (for a hackathon demo). Change the password.
SEED_DEMO=true
DEMO_EMAIL=rohit.demo@example.com
DEMO_PASSWORD=

# Set by the Docker image; change only if you run without it.
# DATABASE_URL=sqlite:////data/claimsaathi.db
# STORAGE_DIR=/data/storage
# MODELS_DIR=/data/models
