# Copy this file to .env and change the values.

# Leave unset to use SQLite at backend/claimsaathi.db. Postgres also works, e.g.
# DATABASE_URL=postgresql+psycopg://user:password@host:5432/claimsaathi

# Long random string used to sign login tokens. Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-in-your-own-env-file
JWT_EXPIRE_MINUTES=10080

# Key that encrypts uploaded documents on disk. If unset, one is generated into
# backend/storage/.dev-key (fine locally). In production set it explicitly and keep it safe:
# losing it makes stored documents unreadable. Generate one with:
#   python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
# FILE_ENCRYPTION_KEY=
MAX_UPLOAD_MB=20

# Claude reads policies, labels every clause and explains it in English, Hindi and Hinglish.
# Without a key ClaimSaathi runs in "basic mode": clauses, key terms and waiting periods are
# still read with rules, but there are no plain-language explanations.
# Get a key at https://console.anthropic.com/ and keep it out of git (this .env file is ignored).
# ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5-5
AI_ENABLED=true

# Clause search runs locally with this embedding model (about 220 MB, downloaded on first use
# into backend/models/). Set to false to use keyword search only.
EMBEDDINGS_ENABLED=true

# Frontend address allowed to call the API
CORS_ORIGINS=http://localhost:5173

# Demo account created by `python -m app.seed` (fictional, for local testing only)
DEMO_EMAIL=rohit.demo@example.com
DEMO_PASSWORD=demo-pass-2026
